POSTGRES_USER=nsusosed
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=nsusosed
DATABASE_URL=postgresql+asyncpg://nsusosed:CHANGE_ME_STRONG_PASSWORD@db:5432/nsusosed
# Адрес сайта, как его видит браузер. В продакшене: https://nsusosed.ru
# От него зависят проверка Origin у POST/PUT/DELETE и ссылки-приглашения
# ({PUBLIC_ORIGIN}/join#token=...; страница /join — на фронтенде).
PUBLIC_ORIGIN=http://localhost:8000
ALLOWED_EMAIL_DOMAINS=g.nsu.ru
SESSION_TTL_SECONDS=604800
MAX_SESSIONS_PER_USER=5
LISTING_TTL_DAYS=30
INVITE_TTL_DAYS=7
# Фото жилья: папка, куда бэкенд пишет файлы, и URL, по которому их отдаёт nginx.
# В docker-compose это том media (/data/media). Локально без Docker: MEDIA_DIR=media
# (frontend/dev_server.py отдаёт backend/media как /media/). Бэкапить вместе с базой.
MEDIA_DIR=/data/media
# MEDIA_URL=/media

# ── Yandex Cloud Postbox ──────────────────────────────
# Нужен статический ключ доступа (не API-ключ): консоль Яндекс Облака →
# сервисный аккаунт с ролью postbox.sender → «Создать новый ключ» →
# «Создать статический ключ доступа». ID ключа → POSTBOX_ACCESS_KEY_ID,
# секретный ключ → POSTBOX_SECRET_ACCESS_KEY.
# POSTBOX_SENDER_EMAIL — адрес на домене, подтверждённом в Postbox.
# EMAIL_MODE=postbox — отправлять письма (без ключа и отправителя приложение не запустится)
# EMAIL_MODE=log     — писать коды в лог вместо отправки. Только для локальной разработки!
EMAIL_MODE=postbox
POSTBOX_ACCESS_KEY_ID=
POSTBOX_SECRET_ACCESS_KEY=
POSTBOX_SENDER_EMAIL=
# POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
# POSTBOX_REGION=ru-central1

# ── OTP (код подтверждения) ───────────────────────────
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_CODE_LENGTH=6

# ── Ограничение частоты входа (хранится в Postgres) ───
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_FAILED_VERIFIES_PER_HOUR=10
AUTH_IP_MAX_REQUESTS=20
AUTH_IP_WINDOW_SECONDS=600

# ── Реальный IP клиента за прокси ─────────────────────
# uvicorn берёт IP из X-Forwarded-For только от этих адресов (по умолчанию 127.0.0.1).
# Если прокси ходит в приложение не с 127.0.0.1 (например, из docker-сети),
# укажите его адрес, иначе все клиенты получат один общий лимит по IP.
# FORWARDED_ALLOW_IPS=127.0.0.1
