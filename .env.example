POSTGRES_USER=nsusosed
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=nsusosed
DATABASE_URL=postgresql+asyncpg://nsusosed:CHANGE_ME_STRONG_PASSWORD@db:5432/nsusosed
PUBLIC_ORIGIN=http://localhost:8000
ALLOWED_EMAIL_DOMAINS=g.nsu.ru
SESSION_TTL_SECONDS=604800
MAX_SESSIONS_PER_USER=5
LISTING_TTL_DAYS=30
INVITE_TTL_DAYS=7

# ── Yandex Cloud Postbox ──────────────────────────────
# Получить: консоль Яндекс Облака → Postbox → API-ключи
# Если оставить пустым — код будет выводиться в логи (тестовый режим)
POSTBOX_API_KEY=
POSTBOX_SENDER_EMAIL=
POSTBOX_API_URL=https://postbox.cloud.yandex.net/api/v1/send

# ── OTP (код подтверждения) ───────────────────────────
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_CODE_LENGTH=6

# ── Ограничение частоты входа (хранится в Postgres) ───
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_FAILED_VERIFIES_PER_HOUR=10
AUTH_IP_MAX_REQUESTS=20
AUTH_IP_WINDOW_SECONDS=600

# ── Реальный IP клиента за прокси ─────────────────────
# uvicorn берёт IP из X-Forwarded-For только от этих адресов (по умолчанию 127.0.0.1).
# Если прокси ходит в приложение не с 127.0.0.1 (например, из docker-сети),
# укажите его адрес, иначе все клиенты получат один общий лимит по IP.
# FORWARDED_ALLOW_IPS=127.0.0.1
