# Production settings for the stack. Lives at /etc/nsusosed.env, root:root 0600:
#   sudo install -m 600 -o root -g root /dev/null /etc/nsusosed.env
#   sudo nano /etc/nsusosed.env
# After editing: sudo /usr/local/bin/nsusosed-redeploy
#
# Full list of settings: .env.example in the repo root (the dev template,
# kept up to date with backend/app/config.py). This file lists only what
# production has to set; anything left out uses the default in config.py.
# When a backend setting is renamed or added, check whether it's named here too.
#
# DATABASE_URL is left out on purpose: compose.yaml builds it from the
# POSTGRES_* values below.

# Postgres container. Letters and digits only in the password, since it ends
# up inside a URL: `openssl rand -hex 24`.
# These only take effect the first time the database volume is created.
# Changing the password later means changing it inside Postgres too.
POSTGRES_USER=nsusosed
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nsusosed

# The site as the browser sees it. The Origin check on POST/PUT/DELETE and the
# invite links ({PUBLIC_ORIGIN}/join#token=…) depend on it. No trailing slash.
PUBLIC_ORIGIN=https://nsusosed.ru

ALLOWED_EMAIL_DOMAINS=g.nsu.ru

# Yandex Cloud Postbox, AWS-compatible API. Never EMAIL_MODE=log in
# production: login codes would end up in the container logs.
# A *static access key* of a service account with the postbox.sender role
# (not an API key: Postbox takes those over SMTP only, and SMTP is blocked here).
# Console → service account → Создать новый ключ → Создать статический ключ доступа:
#   Идентификатор ключа → POSTBOX_ACCESS_KEY_ID
#   Ваш секретный ключ  → POSTBOX_SECRET_ACCESS_KEY
# POSTBOX_SENDER_EMAIL must be on a domain verified in Postbox.
EMAIL_MODE=postbox
POSTBOX_ACCESS_KEY_ID=
POSTBOX_SECRET_ACCESS_KEY=
POSTBOX_SENDER_EMAIL=
